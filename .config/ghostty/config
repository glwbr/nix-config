# Window Settings
window-subtitle = working-directory
confirm-close-surface = false
# window-padding-x = 2            # ghostty default
# window-padding-y = 2            # ghostty default
window-padding-balance = true
# window-inherit-font-size = true # ghostty default
# window-vsync = true             # ghostty default
mouse-hide-while-typing = true
# option must act as alt, or option+arrow never reaches the shell as esc-b/esc-f
macos-option-as-alt = true

# Font Configuration
#   brew install --cask font-jetbrains-mono-nerd-font
# font-family = "JetBrainsMono Nerd Font"

# font-style = "Medium"
# font-style-bold = "Bold"
# font-style-italic = "Medium Italic"
# font-style-bold-italic = "Bold Italic"
font-size = 24
# font-thicken = true

font-feature = +liga, +calt, +zero
adjust-cell-height = "10%"
# bold-is-bright = true

# Cursor & Interaction
cursor-invert-fg-bg = true
cursor-opacity = 0.8
adjust-cursor-thickness = 3
# adjust-underline-position = 2

# Theme
theme = Kanagawa Wave
# theme = dark:Rose Pine,light:Rose Pine Dawn
# theme = dark:tokyo_night,light:tokyo_day

# Shell Integration
shell-integration-features = sudo,cursor,title,path

# vim: ft=ghostty
